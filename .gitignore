
.obsidian/

# Python cache and generated files
__pycache__/
*.py[cod]
*$py.class
.Python
*.so

# Virtual environments
.venv/
venv/
env/
ENV/

# Packaging and build artifacts
build/
dist/
*.egg-info/
*.egg
pip-wheel-metadata/

# Test, coverage, and type-checker caches
.pytest_cache/
.mypy_cache/
.pyre/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
test-storage/

# Local archive databases and temporary SQLite files
*.db
*.db-wal
*.db-shm
*.db.bak*
/tools/.bench_fts/
/tools/.pst_poc/

# CA certificate exported by the dovecot-ca Docker test service (Phase 5.1
# Group E). Regenerated on each container start; may be root-owned on the
# host because the container writes to it as root.
/tests/docker/dovecot/ca/*
!/tests/docker/dovecot/ca/.gitkeep

# Bundled readpst binaries (Phase 4.5). The manifest is authored in-repo and
# applied to readpst.exe by tools/fetch_readpst.ps1, so it must stay tracked (D-19).
vendor/readpst/*
!vendor/readpst/readpst.exe.manifest
!vendor/readpst/COPYING

# IDE and editor files
.vscode/
.idea/

# Local configuration and secrets
.env
.env.*
!.env.example

# Operating-system files
.DS_Store
Thumbs.db
Desktop.ini

# Logs and temporary files
logs/
*.log
*.tmp
*.temp

# pst files
*.pst